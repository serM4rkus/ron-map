{
  "name": "ron-map-app",
  "version": "0.0.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "ci-build": "ng build --base-href /"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
